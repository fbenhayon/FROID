# FROID Environment Variables Example
# Copy this file to .env and fill in the values

# Server Configuration
FROID_ALLOWED_ORIGINS=https://www.froid.com.br,https://froid.com.br
FROID_SESSION_TOKEN_TTL_SECONDS=28800
FROID_PUBLIC_URL=https://www.froid.com.br
FROID_LOCAL_AUTH_EMAILs=admin@example.com
FROID_LOCAL_AUTH_PASSWORD=changeme
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_PRO_10=price_10pro
STRIPE_PRICE_PRO_25=price_25pro
STRIPE_PRICE_PLUS_50=price_50plus
STRIPE_PRICE_PLUS_100=price_100plus
STRIPE_PRICE_MASTER_25=price_25master
FROID_TOKEN_ENCRYPTION_KEYS=key1,key2,key3
FROID_CLINICAL_RECORD_ENCRYPTION_KEYS=key1,key2,key3
FROID_SUBSCRIPTIONS_REQUIRED=false
FROID_PROFESSIONAL_APPROVAL_REQUIRED=false
STRIPE_CURRENCY=usd
FROID_ALLOW_LOCAL_BILLING_FALLBACK=false
FROID_LEGAL_ACCEPTANCE_REQUIRED=false
FROID_LEGAL_AUDIT_HMAC_KEY=your_hmac_key
FROID_LEGAL_SUPPLIER_NAME=Froid Ltda.
FROID_LEGAL_SUPPLIER_TAX_ID=00.000.000/0000-00
FROID_LEGAL_SUPPLIER_ADDRESS=Rua Exemplo, 123, Sao Paulo, SP
FROID_LEGAL_CONTACT_EMAIL=privacy@froid.com.br
FROID_LEGAL_PRIVACY_EMAIL=privacy@froid.com.br
FROID_EXPLICA_MODEL=gemini-1.5-pro
FROID_CHROMA_PATH=/data/chroma_db
FROID_DUCKDB_PATH=/data/datamart_anonymous_v3.duckdb
FROID_ANALYTICS_MIN_K=50
FROID_ANALYTICS_MAX_SUPPRESSION_RATIO=0.10
FROID_DATAMART_PSEUDONYM_KEY=your_pseudonym_key
FROID_TURN_URLS=turn:your-turn-server:3478
FROID_TURN_SECRET=your_turn_secret
FROID_TURN_CREDENTIAL_TTL_SECONDS=3600
FROID_ICE_TRANSPORT_POLICY=all
FROID_REQUIRE_TURN=false
FROID_SESSION_REPORTS_PATH=/data/session_reports.json
FROID_IDENTITY_STATE_PATH=/data/identity_state.json
FROID_PATIENT_SESSION_TTL_SECONDS=7200
FROID_PERSISTENCE_MODE=legacy
FROID_DATABASE_URL=postgresql://froid:password@localhost:5432/froid
FROID_RUNTIME_DATABASE_URL=postgresql://froid:password@localhost:5432/froid_runtime
FROID_TENANT_AUTHORIZATION_MODE=off
FROID_TENANT_ENFORCEMENT_ORGANIZATIONS=
FROID_SHARED_CREDITS_MODE=off
FROID_SHARED_CREDITS_ORGANIZATIONS=
FROID_DATA_NETWORK=froid_froid-network
GOOGLE_CLIENT_ID=109290160674-cbmk7j15patqk0679joi43lr2ndm5fal.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_CLIENT_ID=109290160674-cbmk7j15patqk0679joi43lr2ndm5fal.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_AUTH_DEV_FALLBACK=false
POSTGRES_USER=froid
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=froid