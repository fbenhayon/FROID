froid.com.br, www.froid.com.br {
    encode gzip

    handle /api/* {
        reverse_proxy froid-backend:8000
    }

    handle /ws/* {
        reverse_proxy froid-backend:8000
    }

    handle /health {
        reverse_proxy froid-backend:8000
    }

    # Painel FROID (SPA React) — rotas de acesso preservadas + bundles Vite
    @app {
        path /app /app/* /login /login/* /entrar /cadastro /cadastro/* /access/* /convite/* /assets/* /vite.svg /favicon.ico
    }
    handle @app {
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy froid-frontend:80
    }

    # Site institucional estático (froid-site) — raiz e demais páginas
    handle {
        root * /srv/froid-site
        @html {
            path / /*.html /ciencia /tecnologia /froid-explica /etica /seguranca /profissionais /precos /demonstracao /faq /glossario /privacidade /termos /sobre-contato
        }
        header @html Cache-Control "no-store, no-cache, must-revalidate"
        header /site-assets/* Cache-Control "public, max-age=604800"
        try_files {path} {path}.html {path}/index.html
        file_server
    }
}
