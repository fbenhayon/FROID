froid.com.br, www.froid.com.br {
    encode gzip

    @app_shell {
        path /
        path /index.html
    }
    header @app_shell Cache-Control "no-store, no-cache, must-revalidate"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    handle /api/* {
        reverse_proxy froid-backend:8000
    }

    handle /ws/* {
        reverse_proxy froid-backend:8000
    }

    handle /health {
        reverse_proxy froid-backend:8000
    }

    handle {
        reverse_proxy froid-frontend:80
    }
}
