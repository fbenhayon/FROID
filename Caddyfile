froid.com.br, www.froid.com.br {
    encode gzip

    # Limite global de corpo de requisição (defesa contra exaustão de memória e
    # DoS por payload grande). Os endpoints de ingestão têm tetos próprios menores.
    request_body {
        max_size 12MB
    }

    # Cabeçalhos de segurança aplicados a todas as respostas.
    header {
        # Força HTTPS no navegador por 2 anos, incluindo subdomínios.
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        # Bloqueia sniffing de MIME.
        X-Content-Type-Options "nosniff"
        # Impede enquadramento do site (clickjacking).
        X-Frame-Options "DENY"
        # Não vaza a URL de origem para terceiros.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Libera apenas câmera/microfone (necessários à sessão), nega o resto.
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
        # Política de conteúdo: permite o próprio site, o CDN do MediaPipe (FACS)
        # e os modelos; bloqueia enquadramento por terceiros.
        # connect-src inclui turn:/turns:/stun:/stuns: — sem eles o navegador
        # bloqueia a negociação ICE do WebRTC (câmera/mic conectam localmente,
        # mas a chamada cai em segundos por não alcançar o TURN/STUN).
        # worker-src inclui o CDN do MediaPipe (FACS), que carrega worker/wasm
        # de lá, não apenas de blob:.
        #
        # `blob:` EM script-src É O QUE LIGA A ANÁLISE ACÚSTICA. Não é
        # duplicata do `blob:` que já está em worker-src: o AudioWorklet —
        # `ctx.audioWorklet.addModule(blobUrl)` em `froid-acoustic.ts`, que é
        # como o PCM cru do paciente é capturado — é buscado sob **script-src**,
        # enquanto worker-src governa Worker/SharedWorker/ServiceWorker. Sem
        # ele o navegador do paciente recusava o módulo, `startF0Capture` caía
        # no catch e devolvia uma função de parada vazia, e NENHUM byte de áudio
        # subia. Em toda sessão, para todo paciente.
        #
        # Apurado em 06/09/2026, e a assimetria foi o que entregou a causa: a
        # leitura FACIAL funcionava e a acústica não, saindo as duas da MESMA
        # página do paciente, com a mesma autenticação, para o mesmo servidor.
        # O MediaPipe carrega de https://cdn.jsdelivr.net, que está liberado; o
        # worklet carrega de blob:, que não estava. Do lado do profissional o
        # gráfico de IPM funcionava porque aquele caminho usa AnalyserNode, sem
        # worklet — e foi esse contraste que localizou o defeito.
        #
        # Medido antes de mexer: `docker compose logs froid-backend | grep -c
        # acoustic-f0` devolveu ZERO. O áudio nunca saiu do navegador.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: turn: turns: stun: stuns: https://cdn.jsdelivr.net https://storage.googleapis.com; media-src 'self' blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        # Remove o cabeçalho que revela o servidor.
        -Server
    }

    handle /api/* {
        reverse_proxy froid-backend:8000
    }

    handle /ws/* {
        reverse_proxy froid-backend:8000
    }

    handle /health {
        reverse_proxy froid-backend:8000
    }

    # Painel FROID (SPA React) — rotas de acesso preservadas + bundles Vite
    @app {
        path /app /app/* /login /login/* /entrar /cadastro /cadastro/* /paciente /paciente/* /avaliacao /access/* /convite/* /assets/* /vite.svg /favicon.ico
    }
    handle @app {
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy froid-frontend:80
    }

    # As 10 habilidades do FROID Psique (psique/percepcao-clinica.html): só com
    # a senha que o Fábio fornece. Pedido do dono em 10/11/2026.
    #
    # A senha é conferida AQUI, no servidor. Conferida em JavaScript ela
    # estaria escrita na própria página, ao alcance de "ver código-fonte".
    # O casamento é por expressão regular, sem distinguir maiúscula: pega
    # /psique/percepcao-clinica.html, /psique/percepcao-clinica (o try_files
    # serve sem extensão), /Psique/Percepcao-Clinica e o redirecionamento
    # deixado na raiz.
    #
    # O hash (bcrypt, em base64) vem da variável FROID_PERCEPCAO_SENHA_HASH,
    # gravada no .env por ops/definir-senha-percepcao.sh. FALHA FECHADA: sem a
    # variável, vale o padrão abaixo, hash de um segredo aleatório que ninguém
    # guardou, e a página não abre para ninguém. Variável DEFINIDA porém
    # VAZIA é outra coisa: o Caddy recusa a configuração e não sobe, e o site
    # inteiro cai (medido em 10/11/2026 num contêiner descartável). Por isso o
    # docker-compose.yml repassa a variável sem valor padrão, e o script valida
    # a configuração antes de reiniciar o froid-edge.
    @percepcao path_regexp percepcao (?i)percepcao-clinica
    handle @percepcao {
        basic_auth bcrypt "FROID - acesso restrito" {
            {$FROID_PERCEPCAO_USUARIO:froid} {$FROID_PERCEPCAO_SENHA_HASH:JDJhJDE0JGV4WnBDdnEzLlpGUE1ybjBTbVNNRmVXNjguWEE2OTVEV0VrdE0wTzkwcTdzS0paOVY1dXFX}
        }
        header Cache-Control "no-store, no-cache, must-revalidate"
        header X-Robots-Tag "noindex, nofollow"
        root * /srv/froid-site
        try_files {path} {path}.html
        file_server
    }

    # Site institucional estático (froid-site) — raiz e demais páginas
    handle {
        root * /srv/froid-site
        @html {
            # Qualquer pagina, em qualquer profundidade: caminho terminado em
            # .html, em / (pasta, servida pelo index.html) ou sem extensao
            # (servido por try_files {path}.html). A lista anterior, caminho a
            # caminho, parava em dois niveis e deixou de fora /en/psique/*.html
            # quando o site foi separado em psique/ e nr1/ (09/11/2026).
            # Arquivos de /site-assets/ tem extensao e nao entram.
            path_regexp ^(/[^.]*|.*\.html)$
        }
        header @html Cache-Control "no-store, no-cache, must-revalidate"
        header /site-assets/* Cache-Control "public, max-age=604800"
        try_files {path} {path}.html {path}/index.html
        file_server
    }
}
