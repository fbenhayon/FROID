# Phase 1 defaults to the existing JSON persistence. Do not change this value
# until the backup and backfill checks in docs/MULTITENANT_PHASE1.md pass.
FROID_PERSISTENCE_MODE=legacy
FROID_TENANT_AUTHORIZATION_MODE=off
FROID_TENANT_ENFORCEMENT_ORGANIZATIONS=
FROID_SHARED_CREDITS_MODE=off
FROID_SHARED_CREDITS_ORGANIZATIONS=
FROID_ALLOW_LOCAL_BILLING_FALLBACK=false
GOOGLE_AUTH_DEV_FALLBACK=false
FROID_ALLOWED_ORIGINS=https://www.froid.com.br,https://froid.com.br
FROID_SESSION_TOKEN_TTL_SECONDS=28800
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_10=
STRIPE_PRICE_PRO_25=
STRIPE_PRICE_PLUS_50=
STRIPE_PRICE_PLUS_100=
STRIPE_PRICE_MASTER_25=
FROID_TOKEN_ENCRYPTION_KEYS=
FROID_CLINICAL_RECORD_ENCRYPTION_KEYS=
FROID_SUBSCRIPTIONS_REQUIRED=false

# Use a long, randomly generated password in production.
FROID_POSTGRES_DB=froid
FROID_POSTGRES_USER=froid
FROID_POSTGRES_PASSWORD=replace-with-a-random-secret
FROID_DATABASE_URL=postgresql://froid:replace-with-a-random-secret@froid-postgres:5432/froid
FROID_RUNTIME_DATABASE_URL=postgresql://froid_runtime:replace-with-a-different-random-secret@froid-postgres:5432/froid
