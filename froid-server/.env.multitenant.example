# Phase 1 defaults to the existing JSON persistence. Do not change this value
# until the backup and backfill checks in docs/MULTITENANT_PHASE1.md pass.
FROID_PERSISTENCE_MODE=legacy
FROID_TENANT_AUTHORIZATION_MODE=off
FROID_TENANT_ENFORCEMENT_ORGANIZATIONS=
FROID_SHARED_CREDITS_MODE=off
FROID_SHARED_CREDITS_ORGANIZATIONS=
FROID_ALLOW_LOCAL_BILLING_FALLBACK=false
GOOGLE_AUTH_DEV_FALLBACK=false
FROID_ALLOWED_ORIGINS=https://www.froid.com.br,https://froid.com.br
FROID_SESSION_TOKEN_TTL_SECONDS=28800
FROID_PATIENT_SESSION_TTL_SECONDS=7200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_10=
STRIPE_PRICE_PRO_25=
STRIPE_PRICE_PLUS_50=
STRIPE_PRICE_PLUS_100=
STRIPE_PRICE_MASTER_25=
FROID_TOKEN_ENCRYPTION_KEYS=
FROID_CLINICAL_RECORD_ENCRYPTION_KEYS=
FROID_SUBSCRIPTIONS_REQUIRED=false
FROID_BACKUP_ENCRYPTION_PASSPHRASE=
FROID_BACKUP_INTEGRITY_KEY=
FROID_BACKUP_DIR=/root/froid-backups/automatic
FROID_BACKUP_RETENTION_DAYS=30
FROID_BACKUP_POSTGRES_DATABASE=froid_homologacao
FROID_DATAMART_PSEUDONYM_KEY=
FROID_DUCKDB_PATH=/data/datamart_anonymous_v3.duckdb
FROID_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
FROID_TURN_SECRET=
FROID_TURN_CREDENTIAL_TTL_SECONDS=3600
FROID_ICE_TRANSPORT_POLICY=all
FROID_REQUIRE_TURN=false
FROID_ANALYTICS_MIN_K=50
FROID_ANALYTICS_MAX_SUPPRESSION_RATIO=0.10

# Use a long, randomly generated password in production.
FROID_POSTGRES_DB=froid
FROID_POSTGRES_USER=froid
FROID_POSTGRES_PASSWORD=replace-with-a-random-secret
FROID_DATABASE_URL=postgresql://froid:replace-with-a-random-secret@froid-postgres:5432/froid
FROID_RUNTIME_DATABASE_URL=postgresql://froid_runtime:replace-with-a-different-random-secret@froid-postgres:5432/froid

# Versioned contracts. The global flag is a compatibility fallback only.
# Prefer the independent jurisdiction flags for gradual activation.
FROID_LEGAL_ACCEPTANCE_REQUIRED=false
FROID_LEGAL_ACCEPTANCE_REQUIRED_BR=false
FROID_LEGAL_ACCEPTANCE_REQUIRED_ES=false
FROID_LEGAL_ACCEPTANCE_REQUIRED_FR=false
FROID_LEGAL_ACCEPTANCE_REQUIRED_US=false
FROID_LEGAL_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
FROID_LEGAL_SUPPLIER_NAME=
FROID_LEGAL_SUPPLIER_TAX_ID=
FROID_LEGAL_SUPPLIER_ADDRESS=
FROID_LEGAL_CONTACT_EMAIL=
FROID_LEGAL_PRIVACY_EMAIL=
